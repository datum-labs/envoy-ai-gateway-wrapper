# ---------------------------------------------------------------------------
# Envoy AI Gateway – Observability Console
#
# Required: gateway URL + bearer token (API key or projected token file).
# Without them the UI loads empty and Playground chat returns 503.
# Copy to `.env.local` for local dev.
# ---------------------------------------------------------------------------

# Base URL of the AI gateway (no path suffix). Prefer an in-cluster Service
# URL when the console runs in the same cluster; use the public hostname for
# local/dev against staging.
#
# In-cluster: kubectl get svc -A | rg ai-gateway  (use that ClusterIP Service)
# Staging public / local:
#   https://ai.staging.env.datum.net
ENVOY_AI_GATEWAY_URL=

# Bearer token for gateway (+ metrics if auth is required).
# Local: Dex JWT with audience ai-gateway.
ENVOY_AI_GATEWAY_API_KEY=

# Path to a projected SA token file. Used when ENVOY_AI_GATEWAY_API_KEY is unset.
# In-cluster (staging dashboard):
#   /var/run/secrets/ai-gateway/token
ENVOY_AI_GATEWAY_TOKEN_FILE=

# Optional preferred Playground model id when present in the gateway catalog.
# Example: claude-sonnet-5
ENVOY_AI_GATEWAY_MODEL=

# Prometheus / VictoriaMetrics base (PromQL) or raw /metrics scrape URL.
# Prefer PromQL for real time-range charts.
#
# In-cluster (staging, preferred):
#   http://vmsingle-datum-resource-metrics.datum-system.svc.cluster.local:8429
#
# Local scrape via extproc admin (port 1064), NOT controller :8080:
#   kubectl -n envoy-ai-gateway-system port-forward \
#     $(kubectl -n envoy-ai-gateway-system get pod \
#       -l gateway.envoyproxy.io/owning-gateway-name=ai-gateway \
#       -o jsonpath='{.items[0].metadata.name}') \
#     8080:1064
#   ENVOY_AI_GATEWAY_METRICS_URL=http://localhost:8080/metrics
#
# Defaults to ${ENVOY_AI_GATEWAY_URL}/metrics when unset (usually 404 on the
# public AI hostname).
ENVOY_AI_GATEWAY_METRICS_URL=
